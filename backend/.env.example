APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Aruba port 587 negotiates STARTTLS automatically when the scheme is null.
MAIL_SCHEME=null
MAIL_HOST=smtp.aruba.it
MAIL_PORT=587
MAIL_TIMEOUT=30
MAIL_USERNAME=your_aruba_mailbox@example.com
MAIL_PASSWORD=your_aruba_mailbox_password
MAIL_FROM_ADDRESS=your_aruba_mailbox@example.com
MAIL_FROM_NAME="VistaExpress"
MAIL_EHLO_DOMAIN=vistaexpress.it
BUYER_FRONTEND_URL=http://localhost:3000
SELLER_FRONTEND_URL=http://localhost:3001
EMAIL_VERIFICATION_EXPIRY_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Advertising campaigns. Seller Boost Ads uses the store-level Seller Wallet.
# Stripe below remains for the separate buyer shopping-wallet flow only.
ADS_REVIEW_REQUIRED=true
STRIPE_SECRET_KEY=
STRIPE_RETURN_ORIGINS=http://localhost:3120,http://localhost:3121

# Temporary direct Buyer Wallet funding for local/testing. Set false when a real
# payment gateway should be required.
MARKETPLACE_DEVELOPMENT_TOP_UP=true
# Temporarily enables direct Seller Wallet funding until a payment gateway is connected.
MARKETPLACE_SELLER_WALLET_TOP_UP_ENABLED=true
# Exact additional Stripe checkout return origins, used only in local/testing.
MARKETPLACE_DEVELOPMENT_RETURN_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

VITE_APP_NAME="${APP_NAME}"

# Optional: first admin user when running: php artisan db:seed --class=Database\\Seeders\\AdminSeeder
# Safe on production (firstOrCreate — does not change existing users).
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=use-a-strong-secret
# ADMIN_NAME="Site Admin"
# ADMIN_PHONE=
