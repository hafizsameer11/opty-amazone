# Keep this secret private. It must match PRODUCT_IMAGE_PROCESSOR_TOKEN in
# backend/.env. Generate one with: openssl rand -hex 32
IMAGE_PROCESSOR_TOKEN=replace-with-a-long-random-secret

# The selected local ONNX model is suitable for general optical products.
REMBG_MODEL=birefnet-general
REMBG_HOME=/models

# Input limits must be compatible with Laravel's product upload validation.
MAX_INPUT_BYTES=5242880
MAX_INPUT_PIXELS=25000000
CATALOG_MAX_DIMENSION=1600
WEBP_QUALITY=92

# CPU deployments should start at one job. Increase only after benchmarking.
MAX_CONCURRENT_JOBS=1
